{
  "name": "get-twitter-birthdays",
  "description": "Fetch birthdays of followed Twitter/X users and save them as JSON.",
  "version": "0.0.0",
  "author": "Tomachi <tomachi@tomacheese.com>",
  "bugs": {
    "url": "https://github.com/tomacheese/get-twitter-birthdays/issues"
  },
  "devDependencies": {
    "@book000/eslint-config": "1.16.117",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "@types/tough-cookie": "4.0.5",
    "eslint": "10.14.0",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-promise": "7.3.0",
    "jest": "30.5.2",
    "jest-expect-message": "1.1.3",
    "prettier": "3.9.10",
    "run-z": "2.1.0",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "homepage": "https://github.com/tomacheese/get-twitter-birthdays",
  "jest": {
    "moduleFileExtensions": [
      "js",
      "ts"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "testMatch": [
      "**/*.test.ts"
    ],
    "setupFilesAfterEnv": [
      "jest-expect-message"
    ]
  },
  "license": "MIT",
  "main": "dist/main.js",
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "private": true,
  "repository": {
    "url": "git@github.com:tomacheese/get-twitter-birthdays.git",
    "type": "git"
  },
  "scripts": {
    "auth:google": "tsx ./src/auth-google.ts",
    "dev": "tsx watch ./src/main.ts",
    "fix": "run-z fix:prettier fix:eslint",
    "fix:eslint": "eslint . -c eslint.config.mjs --fix",
    "fix:prettier": "prettier --write src",
    "lint": "run-z lint:prettier,lint:eslint,lint:tsc",
    "lint:eslint": "eslint . -c eslint.config.mjs",
    "lint:prettier": "prettier --check src",
    "lint:tsc": "tsc",
    "preinstall": "npx only-allow pnpm",
    "start": "tsx ./src/main.ts",
    "test": "jest --runInBand --passWithNoTests --detectOpenHandles --forceExit --coverage"
  },
  "dependencies": {
    "@the-convocation/twitter-scraper": "0.22.3",
    "cycletls": "2.0.5",
    "googleapis": "189.0.0",
    "headers-polyfill": "5.0.1",
    "twitter-openapi-typescript": "0.1.6"
  }
}
